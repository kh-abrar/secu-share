# Copy to .env and adjust. Every variable is validated at startup (src/config/env.js).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Required -------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/secushare
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public URL of the web app (comma-separate several; the first one is used in emails)
FRONTEND_URL=http://localhost:5173

# --- Cookies and proxies --------------------------------------------------
# "lax" when the app and API share a site (dev proxy, docker-compose, same domain).
# "none" when the API is on a different site than the app (requires HTTPS).
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production. Must be true with COOKIE_SAMESITE=none.
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API (nginx, load balancer, ...)
TRUST_PROXY=0
# Optional extra allowed origins, fully anchored, e.g. Vercel previews:
# CORS_ORIGIN_PATTERN=^https://my-app-[a-z0-9-]+\.vercel\.app$

# --- Storage (only encrypted blobs are ever stored) -----------------------
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# For S3-compatible services (R2, MinIO, ...):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Limits ---------------------------------------------------------------
# Per file, plaintext bytes (100 MiB)
MAX_FILE_SIZE=104857600
# Per user (10 GiB)
STORAGE_QUOTA_BYTES=10737418240

# --- Email (verification links). Without SMTP, links are logged in development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_FROM="SecuShare <no-reply@example.com>"
