# Settings for docker-compose.yml. Copy to .env and fill in.

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   or: openssl rand -base64 48
SESSION_SECRET=

# Host ports (change if already in use; then update APP_URL to match)
WEB_PORT=8080
MAIL_PORT=8025

# Public URL people use to reach the app
APP_URL=http://localhost:8080
# Set to true once the app is served over HTTPS
COOKIE_SECURE=false

# Storage: "local" (docker volume) or "s3"
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Limits
MAX_FILE_SIZE=104857600
STORAGE_QUOTA_BYTES=10737418240

# Email. Defaults to the bundled Mailpit catcher (http://localhost:8025).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=SecuShare <no-reply@example.com>
