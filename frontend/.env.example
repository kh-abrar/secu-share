# Only needed when the API is NOT served from the same origin under /api
# (e.g. frontend on Vercel, API on another domain). Include the /api suffix.
# VITE_API_URL=https://api.example.com/api

# Keep in sync with the API's MAX_FILE_SIZE (bytes) so oversize files are caught early
# VITE_MAX_FILE_SIZE=104857600

# Development only: where the Vite dev server proxies /api to
# DEV_API_TARGET=http://localhost:4000
